- queries: .
  from: jackfromeast/prevalence-checker
  version: 0.0.1
- include:
    id: 
      # ---------------------- GETTER ----------------------
      - py/prevalence-checker/getattr-builtin                # 1  getattr(obj, name)
      - py/prevalence-checker/getattr-dunder                 # 2  obj.__getattribute__(name)
      - py/prevalence-checker/object-getattr-dunder          # 3  object.__getattribute__(obj, name)
      - py/prevalence-checker/inspect-getattr-static         # 4  inspect.getattr_static(obj, name)
      - py/prevalence-checker/operator-attrgetter-call       # 5  operator.attrgetter(name)(obj)
      - py/prevalence-checker/dir-access-attr                # 6  dir(obj)[index]
      - py/prevalence-checker/vars-access-attr               # 7  vars(obj)[name]
      - py/prevalence-checker/dict-dunder-getattr            # 8  obj.__dict__[name] or .get(name)
      - py/prevalence-checker/inspect-getmembers             # 9  inspect.getmembers(obj)
      - py/prevalence-checker/inspect-getmembers-static      # 10 inspect.getmembers_static(obj)

      # ---------------------- GETITEM ----------------------
      - py/prevalence-checker/getitem-subscript              # 11 dict[key]
      - py/prevalence-checker/dict-get                       # 12 dict.get(key)
      - py/prevalence-checker/dict-pop                       # 13 dict.pop(key)
      - py/prevalence-checker/getitem-dunder                 # 14 dict.__getitem__(key)
      - py/prevalence-checker/operator-getitem               # 15 operator.getitem(dict, key)
      - py/prevalence-checker/operator-getitem-dunder        # 16 operator.__getitem__(dict, key)
      - py/prevalence-checker/operator-itemgetter-call       # 17 operator.itemgetter(key)(dict)

      # ---------------------- SETTER ----------------------
      - py/prevalence-checker/setattr-builtin                # 1  setattr(obj, name, val)
      - py/prevalence-checker/setattr-dunder                 # 2  obj.__setattr__(name, val)
      - py/prevalence-checker/object-setattr-dunder          # 3  object.__setattr__(obj, name, val)
      - py/prevalence-checker/dict-dunder-set-attr           # 4  obj.__dict__[name] = val
      - py/prevalence-checker/setitem-subscript              # 5  dict[key] = val
      - py/prevalence-checker/dict-setdefault                # 6  dict.setdefault(key, val)
      - py/prevalence-checker/dict-update                    # 7  dict.update(key=val)
      - py/prevalence-checker/dict-dunder-setitem            # 8  dict.__setitem__(key, val)
      - py/prevalence-checker/operator-setitem               # 9  operator.setitem(dict, key, val)
      - py/prevalence-checker/operator-setitem-dunder        # 10 operator.__setitem__(dict, key, val)

      # ---------------------- EVAL / EXEC ----------------------
      - py/security/eval-exec                                # 18/19/11 eval or exec(f"...")
- description: prevalence-checker-for-getters-and-setters